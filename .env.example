# CLMS Environment Variables Example
# Copy this to .env and fill in with your own values

# Flask configuration
FLASK_ENV=production
FLASK_SECRET_KEY=your-secret-key-here-change-this

# Server configuration
PORT=5000
FLASK_HOST=0.0.0.0

# Database (if using custom path)
# CLMS_TEST_DB_PATH=/path/to/custom/database.db
