   <property name="styleSheet">
    <string notr="true">
QWidget#centralwidget {
    background-color: #F5F7FA;
}

QLabel {
    color: #1F2937;
}

QLineEdit {
    background-color: white;
    border: 1px solid #D1D5DB;
    border-radius: 7px;
    padding: 7px 9px;
    font-size: 11px;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
}

QPushButton {
    border: none;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: bold;
}

QTableWidget {
    background-color: white;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
    font-size: 10px;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}

QHeaderView::section {
    background-color: #F3F4F6;
    color: #374151;
    font-weight: bold;
    padding: 7px;
    border: none;
}
