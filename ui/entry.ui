}

QPushButton {
    border: none;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: bold;
}

QTableWidget {
    background-color: white;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
