QWidget#centralwidget {
    background-color: #F5F7FA;
}

QLabel {
    color: #1F2937;
}

QLineEdit, QComboBox {
    background-color: white;
    border: 1px solid #D1D5DB;
    border-radius: 7px;
    padding: 7px 9px;
    font-size: 11px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2563EB;
}

QPushButton {
    border: none;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: bold;
}

QTableWidget {
    background-color: white;
    border: 1px solid #E5E7EB;
